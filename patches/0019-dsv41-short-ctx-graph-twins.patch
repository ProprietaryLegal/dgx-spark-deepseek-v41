+++ b/vllm/v1/worker/gpu/short_ctx.py
@@ -0,0 +1,40 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Short-context CUDA graph twins (VLLM_SHORT_CTX_BOUNDS, "512,1025" for V4.1; off when unset).
+
+A model can skip work below a context length: DeepSeek-V4.1's sparse indexer selects every compressed entry when they
+number at most index_topk, so its scoring (a GEMM, logits, candidate masks, a top-k) is pointless there, and the model
+already takes that branch when it runs eagerly. Inside a CUDA graph keyed only by batch shape it cannot. With bounds
+set, each FULL uniform-decode graph of the target model gets one twin per bound, captured while capture_bound() returns
+that bound so the model takes its short branch wherever the bound allows it, and dispatch picks the smallest twin
+whose bound covers the batch's longest sequence (dispatch_max_seq_len(), set by the runner with MARGIN added).
+"""
+
+import os
+
+BOUNDS: list[int] = sorted(
+    {int(x) for x in os.environ.get("VLLM_SHORT_CTX_BOUNDS", "").replace(" ", "").split(",") if x}
+)
+MARGIN = int(os.environ.get("VLLM_SHORT_CTX_MARGIN", "16"))
+
+_capture_bound: int | None = None
+_dispatch_max_seq_len: int | None = None
+
+
+def capture_bound() -> int | None:
+    """The context bound of the graph being captured, or None (not a twin, or not capturing)."""
+    return _capture_bound
+
+
+def set_capture_bound(bound: int | None) -> None:
+    global _capture_bound
+    _capture_bound = bound
+
+
+def dispatch_max_seq_len() -> int | None:
+    """The longest sequence of the batch about to dispatch (+ MARGIN), or None when unknown (no twin then)."""
+    return _dispatch_max_seq_len
+
+
+def set_dispatch_max_seq_len(n: int | None) -> None:
+    global _dispatch_max_seq_len
+    _dispatch_max_seq_len = n
