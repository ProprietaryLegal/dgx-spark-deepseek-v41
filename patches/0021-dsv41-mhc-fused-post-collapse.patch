+def _exl3_post_collapse(x, residual, pre_mix, norm_weight):
+    """vllm_exl3_moe's one-launch mHC post + carried-pre collapse + RMSNorm, or
+    None (plugin absent, switched off, or an unsupported shape)."""
+    if pre_mix is None or norm_weight is None:
+        return None
+    try:
+        from vllm_exl3_moe import mhc as exl3_mhc
+    except ImportError:
+        return None
+    if not exl3_mhc.ENABLED or not exl3_mhc.supported(x, residual):
+        return None
+    return exl3_mhc.post_collapse
