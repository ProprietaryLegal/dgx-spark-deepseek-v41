@@ -821,6 +821,30 @@ class KpoolTailMetadataBuilder(AttentionMetadataBuilder):
         )
 
 
+def _indexer_prefill_buffer_factor() -> int:
+    """dsv41 patch 0025: the prefill gather buffer in units of max_model_len.
+
+    VLLM_INDEXER_PREFILL_BUFFER_FACTOR, default 8 (upstream: 40). The chunker
+    (_split_indexer_prefill_chunks) packs a step's prefills into chunks whose
+    gathered rows fit the buffer but takes a longer single request whole, so the
+    buffer must hold one request (max_model_len rows plus its draft tokens):
+    factors under 2 are refused.
+    """
+    import os
+
+    raw = os.environ.get("VLLM_INDEXER_PREFILL_BUFFER_FACTOR") or "8"
+    try:
+        factor = int(raw)
+    except ValueError:
+        factor = 0
+    if factor < 2:
+        raise ValueError(
+            f"VLLM_INDEXER_PREFILL_BUFFER_FACTOR={raw!r}: want an integer >= 2 "
+            "(dsv41 default 8, upstream 40)"
+        )
+    return factor
+
+
 def get_max_prefill_buffer_size(vllm_config: VllmConfig):
     max_model_len = vllm_config.model_config.max_model_len
     # NOTE(Chen): 40 is a magic number for controlling the prefill buffer size.
@@ -831,7 +855,18 @@ def get_max_prefill_buffer_size(vllm_config: VllmConfig):
     # within the flashmla_sparse workspace.
     # For DeepSeek-V3.2, the max_model_len is 163840.
     #   40 * 163840 * 132 = 865075200 bytes = 825 MB
-    return max_model_len * 40
+    # dsv41 patch 0025: 8 by default. V4.1's index layers 20-36 keep one row a
+    # token (compress ratio 1), so at max_model_len 262,144 the buffer held
+    # 40 x 262,144 x 132 B = 1.29 GiB of workspace for the server's life; 8 x is
+    # 0.26 GiB, the keys of 8 full-length requests, more than one chunk takes
+    # before the logits cap (VLLM_SPARSE_INDEXER_MAX_LOGITS_MB) splits it.
+    factor = _indexer_prefill_buffer_factor()
+    logger.info_once(
+        "Sparse indexer prefill buffer: %d x max_model_len rows (patch 0025; "
+        "VLLM_INDEXER_PREFILL_BUFFER_FACTOR=40 is upstream's)",
+        factor,
+    )
+    return max_model_len * factor
 
 
