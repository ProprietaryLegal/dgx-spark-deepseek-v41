+def engram_wkv_row_parallel(
+    embedding: ParallelEngramEmbedding, use_sequence_parallel: bool
+) -> bool:
+    """Whether wkv runs row-parallel over the hash heads (opt-in with
+    VLLM_ENGRAM_WKV_ROWPAR=1, which must match on every rank).
+
+    The gathered rows are head-major, so a rank whose heads are one equal,
+    contiguous share in TP rank order already holds wkv's input-row shard:
+    it projects those rows alone and one all-reduce of the partial products
+    replaces the all-gather of the rows and the all-gather of wkv's output.
+    Padded heads and DP-sharded tables (other replicas' heads in the rows)
+    break that, and sequence parallelism shards tokens, so those cases and
+    TP=1 keep the column-parallel layout. Every condition reads state the
+    TP ranks share, so all ranks take the same layout.
+    """
+    if os.environ.get("VLLM_ENGRAM_WKV_ROWPAR", "0") != "1":
+        return False
+    tp_size = embedding.tp_size
+    if tp_size == 1:
+        return False
+    if use_sequence_parallel:
+        reason = "sequence parallelism shards tokens, not hash heads"
+    elif embedding.dp_size > 1:
+        reason = f"the tables are DP-sharded over {embedding.dp_size} replicas"
+    elif embedding.part_n_hash_cols * tp_size != embedding.n_hash_cols:
+        reason = (
+            f"{embedding.n_hash_cols} hash heads do not split into "
+            f"{tp_size} equal shares"
+        )
+    else:
+        part = embedding.part_n_hash_cols
+        assert embedding.head_start == get_tensor_model_parallel_rank() * part
+        return True
+    logger.warning_once(
+        "VLLM_ENGRAM_WKV_ROWPAR ignored, Engram wkv stays column-parallel: %s",
+        reason,
+    )
+    return False
+
