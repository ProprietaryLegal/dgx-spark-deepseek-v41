+_STREAMS = os.environ.get("VLLM_SM12X_BMM_STREAMS", "0") == "1"
+_STREAMS_MAX_TOKENS = 16
+_side_streams: dict[int, list[torch.cuda.Stream]] = {}
+
+
+def _streams(device: torch.device, count: int) -> list[torch.cuda.Stream]:
+    i = device.index if device.index is not None else torch.cuda.current_device()
+    have = _side_streams.setdefault(i, [])
+    while len(have) < count:
+        have.append(torch.cuda.Stream(device=device))
+    return have[:count]
+
+
+def _sm12x_marlin_bmm_streams(x, weight, scales, groups, n, k, apply):
+    """The groups' GEMMs concurrently: group 0 on the calling stream, the others on
+    side streams that wait for the calling stream's work so far and that the calling
+    stream waits for before the stack (a fork / join a CUDA graph captures too)."""
+    cur = torch.cuda.current_stream()
+    side = _streams(x.device, groups - 1)
+    outs: list[torch.Tensor | None] = [None] * groups
+    for s in side:
+        s.wait_stream(cur)
+    for i in range(groups):
+        s = cur if i == 0 else side[i - 1]
+        with torch.cuda.stream(s):
+            outs[i] = apply(
+                input=x[:, i, :].contiguous(),
+                weight=weight[i],
+                weight_scale=scales[i],
+                workspace=None,
+                size_n=n,
+                size_k=k,
+            )
+    for s in side:
+        cur.wait_stream(s)
+    # No record_stream: the side streams are this function's own, and each call first
+    # makes them wait for the calling stream, so a side-stream reuse of these outputs'
+    # blocks is ordered after the stack below (vLLM's multi-stream helpers rely on
+    # the same ordering).
+    return torch.stack(outs, dim=1)
+
