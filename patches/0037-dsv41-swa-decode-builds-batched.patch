+        n_tokens, n_slots, n_lens = b0.num_tokens, b0.is_valid.shape[0], b0.lens.shape[0]
+        n_main = max(n_tokens, n_slots)
+        fill = 1024
+        n_fill = triton.cdiv(max(n_lens - n_tokens, 0), fill)
