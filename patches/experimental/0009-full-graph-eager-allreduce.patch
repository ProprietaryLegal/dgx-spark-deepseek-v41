         )
 
 
+_no_allreduce_break = threading.local()
+
+
+@contextlib.contextmanager
+def no_allreduce_break():
+    """All-reduces issued inside stay in the graph: a region where side streams
+    are forked (maybe_execute_in_parallel / execute_in_parallel) cannot end a
+    capture segment."""
+    depth = getattr(_no_allreduce_break, "depth", 0)
+    _no_allreduce_break.depth = depth + 1
+    try:
+        yield
+    finally:
+        _no_allreduce_break.depth = depth
+
+
+def eager_all_reduce_break(device_communicator: Any, input_: torch.Tensor) -> torch.Tensor | None:
+    """Inside a FULL capture made with BreakableCUDAGraphCapture (VLLM_FULL_GRAPH_EAGER_ALLREDUCE=1): end the current
+    segment, run this all-reduce eagerly with PyNccl into an output buffer from the graph pool, record it for replay
+    and start the next segment. Returns that buffer; None when no such capture is active or the all-reduce would not
+    take the plain PyNccl path (custom / quick / symmetric-memory / FlashInfer all-reduces stay inside the graph).
+
+    Why: with multi-node tensor parallelism over RoCE, a decode-size NCCL all-reduce captured inside a CUDA graph
+    cost 50-160 us against 26-42 us eager (2x DGX Spark, no NCCL setting changed that), while attention and every
+    other op of the step keep the full-graph replay."""
+    if not is_full_graph_eager_allreduce_enabled():
+        return None
+    cap = BreakableCUDAGraphCapture.current()
+    if cap is None or not cap._capturing or not cap.allreduce_only:
+        return None
+    if getattr(_no_allreduce_break, "depth", 0):
+        return None
+    pynccl = getattr(device_communicator, "pynccl_comm", None)
+    if pynccl is None or pynccl.disabled or not input_.is_contiguous():
+        return None
+    for name in ("ca_comm", "qr_comm", "fi_ar_comm", "fi_pcie_ipc_ar_comm", "aiter_ar_comm", "symm_mem_comm"):
+        comm = getattr(device_communicator, name, None)
+        if comm is not None and not getattr(comm, "disabled", False):
+            return None
+    out = torch.empty_like(input_)
+    inp_w, out_w = weak_ref_tensor(input_), weak_ref_tensor(out)
+    logger.info_once("FULL cudagraph: tensor-parallel all-reduces run eagerly between graph segments")
+    cap.add_eager(lambda: pynccl.all_reduce(inp_w, out_w))
+    return out
+
+
